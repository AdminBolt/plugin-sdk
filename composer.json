{
    "name": "adminbolt/plugin-sdk",
    "description": "PHP SDK for building AdminBolt panel plugins",
    "type": "library",
    "license": "MIT",
    "keywords": ["adminbolt", "plugin", "sdk", "hosting", "control-panel"],
    "homepage": "https://github.com/AdminBolt/plugin-sdk",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "AdminBolt\\Plugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdminBolt\\Plugin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
