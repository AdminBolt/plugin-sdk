{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/AdminBolt/plugin-sdk/main/schema/plugin.schema.json",
    "title": "AdminBolt plugin manifest",
    "description": "plugin.json, the file the panel reads before it trusts a plugin.",
    "type": "object",
    "required": [
        "id",
        "name",
        "version"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "description": "Lower-case kebab-case. Becomes the plugin directory name, the API key label and the hook route."
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "description": "Shown to the operator in the panel."
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$",
            "description": "Semantic version. The panel compares it to decide whether an update is available."
        },
        "description": {
            "type": "string"
        },
        "author": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "license": {
            "type": "string"
        },
        "homepage": {
            "type": "string"
        },
        "icon": {
            "type": "string",
            "description": "Heroicon name, for example heroicon-o-globe-alt."
        },
        "sdk": {
            "type": "string",
            "description": "Composer constraint on adminbolt/plugin-sdk, for example ^1.0."
        },
        "panel": {
            "type": "string",
            "description": "Minimum panel version, for example >=1.9.0. The panel refuses to install a plugin that asks for more than it is."
        },
        "runtime": {
            "type": "object",
            "required": [
                "entrypoint"
            ],
            "additionalProperties": false,
            "properties": {
                "php": {
                    "type": "string",
                    "description": "PHP constraint, for example ^8.2."
                },
                "entrypoint": {
                    "type": "string",
                    "description": "PHP file the panel serves or executes, relative to the plugin root."
                },
                "transport": {
                    "type": "string",
                    "enum": [
                        "http",
                        "cli"
                    ],
                    "default": "http"
                },
                "listen": {
                    "type": "string",
                    "description": "Unix socket path or 127.0.0.1:port the listener binds, for transport http. The panel assigns one if omitted."
                },
                "memory_limit": {
                    "type": "string"
                },
                "user": {
                    "type": "string",
                    "description": "System user the plugin runs as. The panel creates a dedicated unprivileged user by default and refuses root."
                }
            }
        },
        "api": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "scopes": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^(admin|client|reseller):[a-z0-9\\-/*]+:(read|write|execute)$"
                    },
                    "description": "What the plugin API key is allowed to reach. The panel mints the key with exactly these endpoints. \"execute\" is for running the commands declared in \"commands\" and is shown to the administrator on its own."
                }
            }
        },
        "hooks": {
            "type": "array",
            "items": {
                "oneOf": [
                    {
                        "type": "string",
                        "enum": [
                            "domain.creating",
                            "domain.created",
                            "domain.deleting",
                            "domain.deleted",
                            "domain.renamed",
                            "account.creating",
                            "account.created",
                            "account.deleting",
                            "account.deleted",
                            "account.suspended",
                            "account.unsuspended",
                            "account.transferred",
                            "dns_record.creating",
                            "dns_record.created",
                            "dns_record.updated",
                            "dns_record.deleted",
                            "email_account.creating",
                            "email_account.created",
                            "email_account.deleted",
                            "database.creating",
                            "database.created",
                            "database.deleted",
                            "certificate.issued",
                            "webserver.switched",
                            "plugin.installed",
                            "plugin.configured",
                            "plugin.uninstalled"
                        ]
                    },
                    {
                        "type": "object",
                        "required": [
                            "event"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "event": {
                                "type": "string",
                                "enum": [
                                    "domain.creating",
                                    "domain.created",
                                    "domain.deleting",
                                    "domain.deleted",
                                    "domain.renamed",
                                    "account.creating",
                                    "account.created",
                                    "account.deleting",
                                    "account.deleted",
                                    "account.suspended",
                                    "account.unsuspended",
                                    "account.transferred",
                                    "dns_record.creating",
                                    "dns_record.created",
                                    "dns_record.updated",
                                    "dns_record.deleted",
                                    "email_account.creating",
                                    "email_account.created",
                                    "email_account.deleted",
                                    "database.creating",
                                    "database.created",
                                    "database.deleted",
                                    "certificate.issued",
                                    "webserver.switched",
                                    "plugin.installed",
                                    "plugin.configured",
                                    "plugin.uninstalled"
                                ]
                            },
                            "blocking": {
                                "type": "boolean",
                                "default": false,
                                "description": "Only these hooks run inside the operation and may block: domain.creating, domain.deleting, account.creating, account.deleting, dns_record.creating, email_account.creating, database.creating. The panel waits for the answer and honours a rejection."
                            },
                            "timeout": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 30,
                                "default": 5
                            },
                            "on_failure": {
                                "type": "string",
                                "enum": [
                                    "open",
                                    "closed"
                                ],
                                "default": "open",
                                "description": "What the panel does when a blocking hook times out or errors. open proceeds, closed aborts the operation."
                            }
                        }
                    }
                ]
            }
        },
        "settings": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "key"
                ],
                "additionalProperties": false,
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "string",
                            "secret",
                            "bool",
                            "int",
                            "select",
                            "text",
                            "url"
                        ],
                        "default": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "help": {
                        "type": "string"
                    },
                    "required": {
                        "type": "boolean",
                        "default": false
                    },
                    "default": {
                        "description": "Not allowed on a secret."
                    },
                    "options": {
                        "type": "object",
                        "description": "value => label pairs, required for a select."
                    }
                }
            }
        },
        "ui": {
            "type": "array",
            "description": "Pages the panel adds to its navigation for this plugin. A declarative page is described by the plugin and drawn by the panel with its own components; an iframe page is served by the plugin as HTML and proxied by the panel.",
            "items": {
                "type": "object",
                "required": [
                    "panel",
                    "slug",
                    "title"
                ],
                "additionalProperties": false,
                "properties": {
                    "panel": {
                        "type": "string",
                        "enum": [
                            "admin",
                            "client",
                            "reseller"
                        ],
                        "description": "Which panel the page appears in, and therefore who may open it. The panel enforces this; the plugin does not have to."
                    },
                    "slug": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$",
                        "description": "Lower-case kebab-case. Becomes part of the panel URL and is what the plugin registers the page handler under."
                    },
                    "title": {
                        "type": "string",
                        "description": "The navigation entry."
                    },
                    "icon": {
                        "type": "string",
                        "description": "Heroicon name, for example heroicon-o-globe-alt."
                    },
                    "group": {
                        "type": "string",
                        "description": "Navigation group to file the page under."
                    },
                    "render": {
                        "enum": [
                            "declarative",
                            "iframe"
                        ],
                        "default": "declarative",
                        "description": "\"declarative\" means the plugin describes the page and the panel draws it with its own components, which is the right answer almost every time. \"iframe\" means the plugin serves a built front end at /ui/{slug}, which the panel proxies and embeds; it gives up the operator's theme, dark mode, the phone layout and translation."
                    },
                    "sort": {
                        "type": "integer",
                        "description": "Position within the navigation group."
                    },
                    "height": {
                        "enum": [
                            "fill",
                            "auto"
                        ],
                        "default": "fill",
                        "description": "Only for \"render\": \"iframe\". \"fill\" gives the frame the height the panel has and lets it scroll inside; \"auto\" grows the frame to its content and lets the page scroll instead, which needs the front end to report its height."
                    },
                    "edge_to_edge": {
                        "type": "boolean",
                        "default": false,
                        "description": "Only for \"render\": \"iframe\". Drops the card the frame sits in so it spans the page, for a front end that draws its own edges."
                    },
                    "width": {
                        "enum": [
                            "default",
                            "full"
                        ],
                        "default": "default",
                        "description": "Only for \"render\": \"iframe\". \"default\" is the width the panel centres its own pages at; \"full\" is everything between the navigation and the edge of the window."
                    }
                }
            }
        },
        "theme": {
            "type": "object",
            "description": "A stylesheet the plugin offers the panel to wear. Installing it makes the theme available; an operator chooses which theme is in use. The panel keeps its own stylesheet and loads this one after it, so a theme redefines the tokens it cares about rather than rebuilding everything.",
            "required": [
                "name",
                "css"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "What an operator picks from the plugins list."
                },
                "css": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._/-]+\\.css$",
                    "description": "The stylesheet, relative to the plugin root, for example \"dist/theme.css\". The panel serves it as text/css and will serve nothing else."
                },
                "panels": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "enum": [
                            "admin",
                            "client",
                            "reseller"
                        ]
                    },
                    "description": "Which panels it repaints. All three when left out."
                },
                "description": {
                    "type": "string",
                    "description": "One line about the look, shown on the install screen."
                }
            }
        },
        "slots": {
            "type": "array",
            "description": "Places in the panel's own layout where the plugin draws something. A page is somewhere a customer goes; a slot is something they meet without going anywhere. What the plugin returns is a page description and the panel renders it with its own components, so a slot carries no markup either.",
            "items": {
                "type": "object",
                "required": [
                    "panel",
                    "position",
                    "slug"
                ],
                "additionalProperties": false,
                "properties": {
                    "panel": {
                        "type": "string",
                        "enum": [
                            "admin",
                            "client",
                            "reseller"
                        ],
                        "description": "Which panel it is drawn in, and therefore who sees it."
                    },
                    "position": {
                        "type": "string",
                        "enum": [
                            "auth.login.form.after",
                            "auth.login.form.before",
                            "auth.password-reset.request.form.after",
                            "auth.password-reset.request.form.before",
                            "auth.password-reset.reset.form.after",
                            "auth.password-reset.reset.form.before",
                            "auth.register.form.after",
                            "auth.register.form.before",
                            "body.end",
                            "body.start",
                            "content.after",
                            "content.before",
                            "content.end",
                            "content.start",
                            "footer",
                            "global-search.after",
                            "global-search.before",
                            "global-search.end",
                            "global-search.start",
                            "page.end",
                            "page.footer-widgets.after",
                            "page.footer-widgets.before",
                            "page.header-widgets.after",
                            "page.header-widgets.before",
                            "page.header.actions.after",
                            "page.header.actions.before",
                            "page.start",
                            "page.sub-navigation.end.after",
                            "page.sub-navigation.end.before",
                            "page.sub-navigation.select.after",
                            "page.sub-navigation.select.before",
                            "page.sub-navigation.sidebar.after",
                            "page.sub-navigation.sidebar.before",
                            "page.sub-navigation.start.after",
                            "page.sub-navigation.start.before",
                            "page.sub-navigation.top.after",
                            "page.sub-navigation.top.before",
                            "resource.pages.list-records.table.after",
                            "resource.pages.list-records.table.before",
                            "resource.pages.list-records.tabs.end",
                            "resource.pages.list-records.tabs.start",
                            "resource.pages.manage-related-records.table.after",
                            "resource.pages.manage-related-records.table.before",
                            "resource.relation-manager.after",
                            "resource.relation-manager.before",
                            "resource.tabs.end",
                            "resource.tabs.start",
                            "sidebar.footer",
                            "sidebar.nav.end",
                            "sidebar.nav.start",
                            "simple-page.end",
                            "simple-page.start",
                            "tenant-menu.after",
                            "tenant-menu.before",
                            "topbar.after",
                            "topbar.before",
                            "topbar.end",
                            "topbar.start",
                            "user-menu.after",
                            "user-menu.before",
                            "user-menu.profile.after",
                            "user-menu.profile.before"
                        ],
                        "description": "Where in the panel it is drawn. These are the panel's own names, the same list as SlotPosition in the SDK, and the panel maps them to whatever it renders with; a plugin that declares \"footer\" keeps drawing in the footer whatever the panel is built on."
                    },
                    "slug": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$",
                        "description": "Lower-case kebab-case. What the plugin registers the slot handler under."
                    },
                    "label": {
                        "type": "string",
                        "description": "What the install screen calls this slot. Without one the panel turns the position into words, which reads like a Filament identifier because it is one."
                    },
                    "sort": {
                        "type": "integer",
                        "description": "Order among this plugin's own slots in the same position."
                    },
                    "cache": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3600,
                        "default": 60,
                        "description": "How long the panel may reuse what this slot returned, in seconds. A slot renders on pages that have nothing to do with the plugin, so 0 means a round trip on every request in the panel."
                    }
                }
            }
        },
        "commands": {
            "type": "array",
            "description": "Commands the plugin may run in an account. An administrator approves these by name and by argument, and the panel builds every command line from its own copy of them, so a plugin can never run something it did not declare here.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                        "description": "What the plugin passes to cli()->run()."
                    },
                    "label": {
                        "type": "string",
                        "description": "What the administrator reads on the approval screen."
                    },
                    "description": {
                        "type": "string"
                    },
                    "program": {
                        "type": "string",
                        "description": "For a single-step command; shorthand for one entry in \"steps\"."
                    },
                    "args": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 512
                        },
                        "maxItems": 32
                    },
                    "steps": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 12,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "program"
                            ],
                            "properties": {
                                "program": {
                                    "type": "string",
                                    "description": "A program name the panel is configured to run, such as \"php\" or \"composer\". Never a path: the panel resolves it, and resolves \"php\" to the version the account is on."
                                },
                                "args": {
                                    "type": "array",
                                    "maxItems": 32,
                                    "items": {
                                        "type": "string",
                                        "maxLength": 512
                                    },
                                    "description": "The argument template. A placeholder is written {name} and must be declared in \"params\"."
                                }
                            }
                        },
                        "description": "Run in order, stopping at the first non-zero exit. One approval and one invocation for something like a deploy, with no shell to sequence it."
                    },
                    "params": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "type"
                            ],
                            "properties": {
                                "type": {
                                    "enum": [
                                        "enum",
                                        "path",
                                        "token",
                                        "pattern",
                                        "int"
                                    ],
                                    "description": "There is deliberately no free string type: a parameter a plugin can fill with anything is a command a plugin can rewrite."
                                },
                                "values": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Required for \"enum\": the only values this parameter accepts."
                                },
                                "pattern": {
                                    "type": "string",
                                    "maxLength": 256,
                                    "description": "Required for \"pattern\". Write the body only; the panel anchors it."
                                },
                                "min": {
                                    "type": "integer"
                                },
                                "max": {
                                    "type": "integer"
                                },
                                "required": {
                                    "type": "boolean",
                                    "default": true
                                },
                                "default": {
                                    "type": [
                                        "string",
                                        "number",
                                        "boolean"
                                    ]
                                },
                                "label": {
                                    "type": "string"
                                }
                            }
                        },
                        "propertyNames": {
                            "pattern": "^[a-z][a-z0-9_]*$"
                        }
                    },
                    "cwd": {
                        "enum": [
                            "required",
                            "optional",
                            "none"
                        ],
                        "default": "required",
                        "description": "Whether the caller names a directory inside the account home for the command to run in."
                    },
                    "timeout": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1800,
                        "default": 60
                    },
                    "async": {
                        "type": "boolean",
                        "default": false,
                        "description": "Run it as a job the plugin polls, for anything that outlives a request."
                    }
                }
            }
        }
    }
}
