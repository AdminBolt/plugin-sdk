{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/AdminBolt/plugin-sdk/main/schema/plugin.schema.json",
    "title": "AdminBolt plugin manifest",
    "description": "plugin.json, the file the panel reads before it trusts a plugin.",
    "type": "object",
    "required": [
        "id",
        "name",
        "version",
        "runtime"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "description": "Lower-case kebab-case. Becomes the plugin directory name, the API key label and the hook route."
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "description": "Shown to the operator in the panel."
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$",
            "description": "Semantic version. The panel compares it to decide whether an update is available."
        },
        "description": {
            "type": "string"
        },
        "author": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "license": {
            "type": "string"
        },
        "homepage": {
            "type": "string"
        },
        "icon": {
            "type": "string",
            "description": "Heroicon name, for example heroicon-o-globe-alt."
        },
        "sdk": {
            "type": "string",
            "description": "Composer constraint on adminbolt/plugin-sdk, for example ^1.0."
        },
        "panel": {
            "type": "string",
            "description": "Minimum panel version, for example >=1.9.0. The panel refuses to install a plugin that asks for more than it is."
        },
        "runtime": {
            "type": "object",
            "required": [
                "entrypoint"
            ],
            "additionalProperties": false,
            "properties": {
                "php": {
                    "type": "string",
                    "description": "PHP constraint, for example ^8.2."
                },
                "entrypoint": {
                    "type": "string",
                    "description": "PHP file the panel serves or executes, relative to the plugin root."
                },
                "transport": {
                    "type": "string",
                    "enum": [
                        "http",
                        "cli"
                    ],
                    "default": "http"
                },
                "listen": {
                    "type": "string",
                    "description": "Unix socket path or 127.0.0.1:port the listener binds, for transport http. The panel assigns one if omitted."
                },
                "memory_limit": {
                    "type": "string"
                },
                "user": {
                    "type": "string",
                    "description": "System user the plugin runs as. The panel creates a dedicated unprivileged user by default and refuses root."
                }
            }
        },
        "api": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "scopes": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^(admin|client|reseller):[a-z0-9\\-/*]+:(read|write)$"
                    },
                    "description": "What the plugin API key is allowed to reach. The panel mints the key with exactly these endpoints."
                }
            }
        },
        "hooks": {
            "type": "array",
            "items": {
                "oneOf": [
                    {
                        "type": "string",
                        "enum": [
                            "domain.creating",
                            "domain.created",
                            "domain.deleting",
                            "domain.deleted",
                            "domain.renamed",
                            "account.creating",
                            "account.created",
                            "account.deleting",
                            "account.deleted",
                            "account.suspended",
                            "account.unsuspended",
                            "account.transferred",
                            "dns_record.creating",
                            "dns_record.created",
                            "dns_record.updated",
                            "dns_record.deleted",
                            "email_account.creating",
                            "email_account.created",
                            "email_account.deleted",
                            "database.creating",
                            "database.created",
                            "database.deleted",
                            "certificate.issued",
                            "webserver.switched",
                            "plugin.installed",
                            "plugin.configured",
                            "plugin.uninstalled"
                        ]
                    },
                    {
                        "type": "object",
                        "required": [
                            "event"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "event": {
                                "type": "string",
                                "enum": [
                                    "domain.creating",
                                    "domain.created",
                                    "domain.deleting",
                                    "domain.deleted",
                                    "domain.renamed",
                                    "account.creating",
                                    "account.created",
                                    "account.deleting",
                                    "account.deleted",
                                    "account.suspended",
                                    "account.unsuspended",
                                    "account.transferred",
                                    "dns_record.creating",
                                    "dns_record.created",
                                    "dns_record.updated",
                                    "dns_record.deleted",
                                    "email_account.creating",
                                    "email_account.created",
                                    "email_account.deleted",
                                    "database.creating",
                                    "database.created",
                                    "database.deleted",
                                    "certificate.issued",
                                    "webserver.switched",
                                    "plugin.installed",
                                    "plugin.configured",
                                    "plugin.uninstalled"
                                ]
                            },
                            "blocking": {
                                "type": "boolean",
                                "default": false,
                                "description": "Only these hooks run inside the operation and may block: domain.creating, domain.deleting, account.creating, account.deleting, dns_record.creating, email_account.creating, database.creating. The panel waits for the answer and honours a rejection."
                            },
                            "timeout": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 30,
                                "default": 5
                            },
                            "on_failure": {
                                "type": "string",
                                "enum": [
                                    "open",
                                    "closed"
                                ],
                                "default": "open",
                                "description": "What the panel does when a blocking hook times out or errors. open proceeds, closed aborts the operation."
                            }
                        }
                    }
                ]
            }
        },
        "settings": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "key"
                ],
                "additionalProperties": false,
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "string",
                            "secret",
                            "bool",
                            "int",
                            "select",
                            "text",
                            "url"
                        ],
                        "default": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "help": {
                        "type": "string"
                    },
                    "required": {
                        "type": "boolean",
                        "default": false
                    },
                    "default": {
                        "description": "Not allowed on a secret."
                    },
                    "options": {
                        "type": "object",
                        "description": "value => label pairs, required for a select."
                    }
                }
            }
        },
        "ui": {
            "type": "array",
            "description": "Pages the panel renders for this plugin, in an iframe served by the plugin itself.",
            "items": {
                "type": "object",
                "required": [
                    "panel",
                    "slug",
                    "title"
                ],
                "additionalProperties": false,
                "properties": {
                    "panel": {
                        "type": "string",
                        "enum": [
                            "admin",
                            "client",
                            "reseller"
                        ]
                    },
                    "slug": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "title": {
                        "type": "string"
                    },
                    "icon": {
                        "type": "string"
                    },
                    "path": {
                        "type": "string",
                        "default": "/ui",
                        "description": "Path on the plugin listener that serves the page."
                    },
                    "group": {
                        "type": "string",
                        "description": "Navigation group the page appears under."
                    }
                }
            }
        }
    }
}
